# Server
NODE_ENV=development
PORT=4000

# MongoDB (local or MongoDB Atlas SRV URI)
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker

# JWT — use a long random value in production (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie settings
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Login rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Admin seed (only used by `npm run seed`)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@doctortracker.local
ADMIN_PASSWORD=change-this-password
